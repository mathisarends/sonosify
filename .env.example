# Sonos Control API credentials from https://integration.sonos.com/
#
# CLIENT_ID and REDIRECT_URI are required to generate an authorization URL.
# CLIENT_SECRET is additionally required to exchange a code and refresh tokens.
# The redirect URI must exactly match a URI registered for the integration,
# e.g. http://localhost:8000/callback for local use.
SONOSIFY_CLOUD_CLIENT_ID=
SONOSIFY_CLOUD_CLIENT_SECRET=
SONOSIFY_CLOUD_REDIRECT_URI=http://localhost:8000/callback

# Reverse-domain identifier required when scheduling Audio Clips.
SONOSIFY_CLOUD_APP_ID=com.example.voice-agent

# Optional defaults for target lookup and token storage.
SONOSIFY_CLOUD_HOUSEHOLD_ID=
SONOSIFY_CLOUD_TOKEN_CACHE=

# Optional alternative to the OAuth login flow for short-lived automation.
# Do not commit a real access token.
SONOSIFY_CLOUD_ACCESS_TOKEN=


SONOS_IP_ADDRESS=your.sonos.ip.address
SONOS_SPEAKER_NAME=your.sonos.speaker.name
